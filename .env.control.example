# Control plane: separate PostgreSQL database and role.
CONTROL_DB_ENGINE=postgresql
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=5432
CONTROL_DB_NAME=optiverse_control
CONTROL_DB_USER=optiverse_control
CONTROL_DB_PASSWORD=replace-with-a-different-generated-password
CONTROL_DJANGO_SECRET_KEY=replace-with-a-generated-secret
CONTROL_DJANGO_DEBUG=False
CONTROL_DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-server-ip
CONTROL_DJANGO_CSRF_TRUSTED_ORIGINS=https://control.your-domain.com
CONTROL_TENANT_DB_ENGINE=postgresql
# Windows local provisioning only. Linux uses protected peer administration.
CONTROL_PG_ADMIN_USER=postgres
CONTROL_PG_ADMIN_PASSWORD=
CONTROL_TENANT_DB_HOST=127.0.0.1
CONTROL_TENANT_DB_PORT=5432
CONTROL_TENANT_CODEBASE_PATH=/opt/optiverse/Smart-Olt
CONTROL_TENANT_BASE_DIR=/opt/optiverse/tenants
CONTROL_TENANT_PANEL_HOST=your-server-ip
CONTROL_BASE_DOMAIN=
CONTROL_VPN_PUBLIC_HOST=
CONTROL_VPN_TUNNEL_POOL=10.75.75.0/24
