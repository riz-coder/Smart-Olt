[Unit]
Description=OptiVerse Master Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/optiverse/Smart-Olt
EnvironmentFile=/opt/optiverse/Smart-Olt/.env.control
ExecStart=/opt/optiverse/Smart-Olt/.venv/bin/python -m daphne -b 0.0.0.0 -p 9000 controlplane.asgi:application
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
