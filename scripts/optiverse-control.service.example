[Unit]
Description=OptiVerse Master Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/optiverse/Smart-Olt
EnvironmentFile=/opt/optiverse/Smart-Olt/.env.control
Environment=OLT_DISABLE_EMBEDDED_SYNC=1
Environment=OLT_ENABLE_EMBEDDED_SYNC=false
ExecStart=/opt/optiverse/Smart-Olt/.venv/bin/gunicorn controlplane.wsgi:application --bind 127.0.0.1:9000 --workers 2 --threads 4 --worker-class gthread --timeout 120 --graceful-timeout 30 --keep-alive 5 --max-requests 2000 --max-requests-jitter 200 --access-logfile - --error-logfile -
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
