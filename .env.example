# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com,your-server-ip
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://your-server-ip
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_TIME_ZONE=Asia/Karachi
DJANGO_LANGUAGE_CODE=en-us

# SQLite runtime database. Keep this outside Git tracking.
SQLITE_DB_PATH=/opt/optiverse/oltportal/db.sqlite3
SQLITE_TIMEOUT_SECONDS=60

# Retention / sampling
OLT_ONU_OPTICAL_SAMPLE_INTERVAL_SECONDS=3600
OLT_ONU_OPTICAL_RETENTION_DAYS=15
OLT_ONU_STATUS_RETENTION_DAYS=30
OLT_ONU_TRAFFIC_RETENTION_DAYS=30
OLT_PON_TRAFFIC_RETENTION_DAYS=30
OLT_PON_PORT_TRAFFIC_RETENTION_DAYS=30
OLT_UPLINK_PORT_TRAFFIC_RETENTION_DAYS=30
OLT_DASHBOARD_STATUS_RETENTION_DAYS=180
OLT_SAMPLE_RETENTION_CLEANUP_SECONDS=3600
OLT_SAMPLE_RETENTION_BATCH_SIZE=5000
OLT_SAMPLE_RETENTION_MAX_BATCHES_PER_MODEL=4

# Email alerts. Use console backend until SMTP is ready.
OLT_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
OLT_EMAIL_HOST=smtp.example.com
OLT_EMAIL_PORT=587
OLT_EMAIL_USE_TLS=true
OLT_EMAIL_USE_SSL=false
OLT_EMAIL_USER=
OLT_EMAIL_PASSWORD=
OLT_EMAIL_FROM=OptiVerse Alerts <alerts@example.com>
OLT_EMAIL_TIMEOUT=20

# Tenant Docker/VPN provisioning
OPTIVERSE_PUBLIC_API_URL=https://your-domain.com
OPTIVERSE_TENANT_AUTO_PROVISION=False
OPTIVERSE_TENANT_BASE_DIR=/opt/optiverse/tenants
OPTIVERSE_WG_SERVER_CONFIG=/etc/wireguard/wg0.conf
OPTIVERSE_WG_RESTART_AFTER_PROVISION=False
CONTROL_TENANT_AUTO_PROVISION=False
CONTROL_TENANT_RUNTIME=docker
# Configure these in .env.control on the VPS; leave domain/endpoint blank locally.
CONTROL_BASE_DOMAIN=
CONTROL_VPN_PUBLIC_HOST=
CONTROL_VPN_PORT_START=52000
CONTROL_VPN_TUNNEL_POOL=10.254.0.0/16
CONTROL_VPN_TRANSPORT_POOL=172.30.0.0/16
CONTROL_CADDY_SITES_DIR=/etc/caddy/optiverse-tenants
CONTROL_PUBLIC_UPSTREAM_PORT=9000
CONTROL_TENANT_BASE_DIR=/opt/optiverse/tenants
CONTROL_WG_SERVER_CONFIG=/etc/wireguard/wg0.conf
CONTROL_WG_RESTART_AFTER_PROVISION=False

# ---------------------------------------------------------------------------
# Optional separate master control plane.
# Use with: python manage_control.py runserver 0.0.0.0:9000
# This DB is only the tenant registry/pricing DB. It must stay separate from
# each ISP tenant app DB.
CONTROL_DJANGO_SECRET_KEY=change-this-control-plane-secret
CONTROL_DJANGO_DEBUG=False
CONTROL_DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-server-ip,your-control-domain.com
CONTROL_DJANGO_CSRF_TRUSTED_ORIGINS=http://your-server-ip,https://your-control-domain.com
CONTROL_SQLITE_DB_PATH=/opt/optiverse/controlplane.sqlite3
CONTROL_SQLITE_TIMEOUT_SECONDS=30

